ex02normalise <- function(x, naRm = TRUE) {
if(!is.numeric(x)){
stop("not numeric")
}
mean <- mean(x,na.rm=naRm)
sigma <- sd(x, na.rm = naRm)
(x-mean)/sigma
}
ex02normalise("abd")
