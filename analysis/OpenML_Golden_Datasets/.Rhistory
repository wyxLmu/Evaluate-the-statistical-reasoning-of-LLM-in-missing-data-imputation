dataset_background <- oml_dataset$desc$description
# B. 从真实数据中自动生成准确的结构化字典 (列名 + 数据类型)
data_dictionary <- data.frame(
name = colnames(raw_data),
data.type = sapply(raw_data, function(x) paste(class(x), collapse = ", ")),
row.names = NULL
)
# 打印预览结果
