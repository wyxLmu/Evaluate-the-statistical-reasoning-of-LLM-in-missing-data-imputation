# 步骤 1: 安装并加载必要的包
# OpenML 用于连接数据库，dplyr 用于优雅地筛选数据
if (!requireNamespace("OpenML", quietly = TRUE)) install.packages("OpenML")
if (!requireNamespace("dplyr", quietly = TRUE)) install.packages("dplyr")
library(OpenML)
library(dplyr)
# 步骤 2: 获取 OpenML 平台上所有数据集的元数据总表
message("正在从 OpenML 获取全局数据集列表，请稍候...")
all_datasets <- listOMLDataSets()
# 步骤 3: 严格按照 Methodology 设定的条件进行过滤
# - 行数 (instances): 3,000 到 100,000
# - 列数 (features): 5 到 25
# - 缺失值 (missing values): 绝对为 0 (保证 Ground Truth)
filtered_datasets <- all_datasets %>%
filter(
number.of.instances >= 3000,
number.of.instances <= 100000,
number.of.features >= 5,
number.of.features <= 25,
number.of.missing.values == 0,
status == "active" # 确保数据集是活跃且可下载的状态
)
# 步骤 4: 随机抽取 60 个数据集，并设置随机种子以保证实验的可重复性 (Reproducibility)
set.seed(2026) # 设为你的毕业年份或任意固定数字
target_n <- 60
if (nrow(filtered_datasets) >= target_n) {
final_datasets <- sample_n(filtered_datasets, target_n)
message("✅ 成功筛选并随机抽取了 ", target_n, " 个符合严格标准的数据集。")
} else {
final_datasets <- filtered_datasets
message("⚠️ 警告：符合严格条件的数据集总数不足 60 个，当前共提取到 ", nrow(filtered_datasets), " 个。")
}
# 步骤 5: 验证与数据字典提取 (以第一个数据集为例)
# 这是你后续喂给 LLM 做 Context-Injected 实验的核心物料
test_id <- final_datasets$data.id[1]
message("正在下载测试数据集 ID: ", test_id, " (", final_datasets$name[1], ")")
# 获取完整数据集对象
oml_dataset <- getOMLDataSet(data.id = test_id)
# 5.1 提取纯表格数据 (这部分将送入 mice::ampute 进行掩码处理)
raw_data <- oml_dataset$data
# 5.2 提取元数据字典 (这部分将使用 XML 标签包装后发给大模型)
data_dictionary <- oml_dataset$features
# 打印预览结果
print("--------------------------------------------------")
print(paste("数据集名称:", oml_dataset$desc$name))
print(paste("数据维度:", nrow(raw_data), "行 x", ncol(raw_data), "列"))
